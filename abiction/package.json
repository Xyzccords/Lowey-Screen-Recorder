{
  "name": "abiction-quick-recorder",
  "version": "0.3.0",
  "description": "Grabador de videollamadas con audio por ventana y compresión de espacio, pensado para Cyberlink PowerDVD.",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder"
  },
  "license": "MIT",
  "dependencies": {
    "ffmpeg-static": "^5.2.0"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.lowey.abiction",
    "productName": "Abiction! - Abi's Quick Recorder",
    "files": [
      "main.js",
      "preload.js",
      "src/**/*",
      "native/**/*",
      "node_modules/**/*"
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-static/**",
      "native/**"
    ],
    "publish": {
      "provider": "github",
      "owner": "Xyzccords",
      "repo": "Lowey-Screen-Recorder",
      "releaseType": "release"
    },
    "win": {
      "target": "nsis"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "uninstallDisplayName": "${productName}"
    }
  }
}
